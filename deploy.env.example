# Copy this file to deploy.env and fill in local deployment settings.
# deploy.env is gitignored and must never contain private keys or passwords.

# SSH alias from ~/.ssh/config. Do not put a private key in this file.
DEPLOY_SSH=your-ssh-alias

# Remote account and deployment directory.
DEPLOY_USER=your-deploy-user
REMOTE_DIR=/home/your-deploy-user/remote-pi

# Docker image names used locally and in the remote Compose project.
IMAGE_NAMESPACE=remote-pi-local
RELAY_VERSION=v0.3.1
SITE_VERSION=v0.1.0

# 0 = local build + SSH image transfer (default); 1 = also push to Docker Hub.
PUBLISH_IMAGES=0

# Public checks after promotion. Leave empty to skip public checks.
TEST_PWA_URL=https://pwa-test.example.com/app
PWA_URL=https://pwa.example.com/app
RELAY_URL=https://relay.example.com

# Optional: set to 1 to keep the generated local image tarball for debugging.
KEEP_IMAGE_ARCHIVE=0
