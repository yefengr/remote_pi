{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "sync:install": "node scripts/sync-install-sh.mjs",
    "build": "node scripts/sync-install-sh.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:legacy": "node --test --import tsx $(find src -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) ! -name '*.browser.test.tsx' ! -name '*.node.test.ts' ! -name '*.node.test.tsx' | sort)",
    "test:unit": "vitest run --project node",
    "test:component": "vitest run --project browser",
    "test:component:watch": "vitest --project browser",
    "test": "pnpm test:legacy && pnpm test:component",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "start:e2e-server": "node scripts/start-e2e-server.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "@noble/ed25519": "^3.1.0",
    "@serwist/next": "9.5.12",
    "@zxing/browser": "^0.2.1",
    "dexie": "^4.4.5",
    "lucide-react": "^1.33.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "1.62.1",
    "serwist": "9.5.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.2.0"
  }
}
